# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/techneest_hrms?retryWrites=true&w=majority

# JWT Authentication Secrets & Expiry
JWT_SECRET=replace_with_a_strong_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_a_separate_strong_64_char_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# Initial Admin Setup Key (Required if creating an additional admin via /api/v1/admin/auth/setup)
ADMIN_SETUP_KEY=replace_with_initial_setup_key

# Rate Limiting
AUTH_RATE_LIMIT_MAX=25
API_RATE_LIMIT_MAX=500

# Nodemailer SMTP Configuration (For Salary Slips & Password Resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hr-noreply@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM="TechNeest HRMS <hr-noreply@example.com>"
