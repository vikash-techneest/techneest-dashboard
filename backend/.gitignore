
cd ~/Desktop/vikram/techneest-dashboard

cat > .gitignore <<'EOF'
# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.npm/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Build output
dist/
build/
out/
.next/
.nuxt/
.output/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime files
pids/
*.pid
*.pid.lock

# Cache
.cache/
.parcel-cache/
.vite/
.turbo/
.eslintcache
.stylelintcache

# Testing
.nyc_output/
playwright-report/
test-results/

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*.orig

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.old

# Local databases and uploaded secrets
*.sqlite
*.sqlite3
*.db
*.pem
*.key
*.p12
*.pfx

# Local deployment configuration
.vercel/
.netlify/

# Package manager debug files
.yarn-integrity
EOF

echo "Git ignore updated successfully"
